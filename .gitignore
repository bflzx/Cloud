# ============================================================
#  Cloud 网盘项目 —— 仓库忽略规则
#  注意:已被 git 跟踪的文件不受本文件影响,需先 git rm --cached
# ============================================================

# ---------- 后端:C++ 编译产物 ----------
# 编译出的可执行文件(是文件,不是 server/ 目录)
/server/server
*.o
*.d
*.gch
*.out
build/
cmake-build-*/

# ---------- 后端:运行期日志(保留目录本身,故不写 *.log 全局规则) ----------
server/log/*
!server/log/.gitkeep

# ---------- 后端:运行期数据(M2 上传/分片会用到) ----------
storage/
server/storage/
*.part
*.tmp

# ---------- 配置与密钥(只保留 .env.example) ----------
.env
*.local
!.env.example

# ---------- 前端:依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/

# ---------- 编辑器 / 操作系统 ----------
.idea/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# ---------- 本地工具/环境目录(可能含凭据,务必忽略) ----------
.codex/
.agents/
.aws/
